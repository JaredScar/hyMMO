$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1040, Height: 660);

  #Title {
    Label #TitleLabel {
      Style: (
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderBold: true,
        RenderUppercase: true,
        FontSize: 16,
        TextColor: #d7e4ea,
        LetterSpacing: 1
      );
      Text: "hyMMO";
    }
  }

  #Content {
    LayoutMode: Left;

    Group #Skills {
      Anchor: (Width: 220);
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 12, Top: 4);
    }

    Group {
      Anchor: (Width: 1, Right: 14);
      Background: #5e512c(0.55);
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #SkillName {
        Style: (
          RenderBold: true,
          RenderUppercase: true,
          FontSize: 22
        );
        Anchor: (Bottom: 4);
      }

      Label #SkillMeta {
        Style: (
          FontSize: 14,
          TextColor: #9eb0c3
        );
        Anchor: (Bottom: 8);
      }

      $C.@ProgressBar #XpBar {
        @Anchor = (Bottom: 6);
      }

      Label #XpLabel {
        Style: (
          FontSize: 13,
          TextColor: #7f93a8
        );
        Anchor: (Bottom: 10);
      }

      Label #Ability {
        Style: (
          FontSize: 14,
          Wrap: true,
          TextColor: #d5deea
        );
        Anchor: (Bottom: 8, Height: 92);
      }

      Label #TreeHint {
        Style: (
          FontSize: 13,
          Wrap: true,
          TextColor: #9eb0c3
        );
        Anchor: (Bottom: 8, Height: 18);
      }

      Label #Notice {
        Visible: false;
        Style: (
          FontSize: 14,
          Wrap: true,
          TextColor: #e8a93b
        );
        Anchor: (Bottom: 8);
      }

      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Anchor: (Top: 6);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Right: 10);

          Label #LeftBranch {
            Style: (
              RenderBold: true,
              RenderUppercase: true,
              FontSize: 13,
              TextColor: #96a9be
            );
            Anchor: (Bottom: 8);
          }

          Group #LeftPath {
            LayoutMode: TopScrolling;
            FlexWeight: 1;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Left: 10);

          Label #RightBranch {
            Style: (
              RenderBold: true,
              RenderUppercase: true,
              FontSize: 13,
              TextColor: #96a9be
            );
            Anchor: (Bottom: 8);
          }

          Group #RightPath {
            LayoutMode: TopScrolling;
            FlexWeight: 1;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 10, Height: 44);

        $C.@CancelTextButton #Respec {
          @Text = "Respec";
          @Anchor = (Width: 150, Right: 16);
        }

        Label #RespecHint {
          FlexWeight: 1;
          Anchor: (Height: 44);
          Style: (
            FontSize: 14,
            Wrap: true,
            VerticalAlignment: Center,
            TextColor: #9eb0c3
          );
        }
      }
    }
  }
}
